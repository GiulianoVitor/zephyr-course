/ {
	aliases{
		app-led-red = &red_led;		//by node
		app-led-green = &green_led;	//by node
		app-led-blue = "/leds/led_2"; 	//by path - make sure you pick the righ name from "zephyr\boards\nxp\frdm_mcxn236\frdm_mcxn236.dts"
	};

	our_driver0: our_driver{
		compatible = "zephyr,our-driver";
		status = "okay";
	};
};
